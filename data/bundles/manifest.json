    {
      "id": "crime",
      "title": "Crime: district and Delhi-wide registered cases",
      "description": "District crime releases 2016 to 2024 and the Delhi-wide printed totals 2011 to 2024, each with its manifest, plus the comparability rules.",
      "series": [
        "ncrb_district_crime",
        "delhi_ut_total_crime",
        "delhi_ut_theft"
      ],
      "geography": "15 police districts (earlier years under the districts reported that year; never re-allocated) and Delhi as a whole. Wards are not used: crime is published by district only.",
      "definitions": [
        "A registered case is a First Information Report recorded by police, so it reflects reporting and registration as well as crime.",
        "IPC became the BNS on 1 July 2024; the 2023 hurt head ('Hurt') and the 2024 head ('Hurt or Grievous Hurt') differ.",
        "A null is unknown, unavailable or not separately reported; it is never zero."
      ],
