    {
      "id": "road",
      "title": "Road safety: crashes, victims, zones and roads, 2004 to 2024",
      "description": "Citywide trend, deaths by mode of travel, enforcement, district tables, named crash-prone zones and road tables for every year held, each release with its manifest.",
      "series": [
        "citywide_road_trend",
        "victims_by_mode",
        "enforcement",
        "traffic_district_tables",
        "named_zones",
        "road_tables",
        "stretches",
        "zone_positions"
      ],
      "geography": "Delhi as a whole, traffic districts as printed each year (11, 12 or 15; never mapped to today's 15 police districts), named locations and roads. Zone positions, where given (2023 and 2024), are hand-placed and approximate (150 m to 5 km).",
      "definitions": [
        "Counts within crash-prone zones are crashes within that year's selected zones, not all crashes, and the zone lists change every year.",
        "A fatal crash is a crash with at least one death; persons killed is a count of people.",
        "Counts, not rates: no traffic or population denominator is published for these series."
      ],
